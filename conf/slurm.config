/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/slurm.config  —  SLURM HPC executor settings
    Usage:  nextflow run main.nf -profile singularity,slurm
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor       = 'slurm'
    clusterOptions = '--account=your_account'   // adjust to your HPC allocation
    queue          = 'normal'
}

// Raise resource caps for HPC nodes (override base.config defaults)
params {
    max_cpus   = 64
    max_memory = 512.GB
    max_time   = 120.h
}

executor {
    queueSize       = 50    // max simultaneous SLURM jobs
    submitRateLimit = '10/1min'
}

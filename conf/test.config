/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/test.config  —  Optional overrides for test profile
    Usage:
      nextflow run main.nf -profile docker,test -params-file params/test.yaml

    Default behavior:
      - This file intentionally does not override any params or resources.
      - All path/input settings should live in params/test.yaml.
      - base.config remains the active default for process resources.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// NOTE:
// Parameter values (project_name, outdir, metadata_file, comparisons, reference
// paths, method/flags, etc.) should be defined only in params/test.yaml.

// -----------------------------------------------------------------------------
// Optional PROCESS overrides for lightweight CI/smoke tests
// Uncomment only when you need test profile to run with smaller resources.
// -----------------------------------------------------------------------------
//
// process {
//     cpus   = 2
//     memory = 6.GB
//     time   = 1.h
//
//     // Example: tighter resources for specific heavy processes
//     // withName: 'kallisto' {
//     //     cpus   = 2
//     //     memory = 8.GB
//     //     time   = 2.h
//     // }
// }
//
// -----------------------------------------------------------------------------
// Optional EXECUTOR/CONTAINER tweaks for CI
// -----------------------------------------------------------------------------
//
// docker {
//     // Example: run as host user in CI
//     // runOptions = '-u $(id -u):$(id -g)'
// }
//

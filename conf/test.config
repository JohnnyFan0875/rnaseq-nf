/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/test.config  —  Minimal dataset profile for CI / smoke-testing
    Usage:  nextflow run main.nf -profile docker,test
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    project_name   = 'test'
    outdir         = 'results/test'

    // Point at a small subsampled dataset committed alongside the pipeline
    metadata_file  = "${projectDir}/test_data/metadata/sample_metadata.csv"

    // Subsampled kallisto index (first 1,000 transcripts only)
    kallisto_index = "${projectDir}/test_data/reference/transcripts.GRCh38.113.sub.fa.idx"
    ref_dir        = "${projectDir}/test_data/reference"

    kallisto_threads  = 2

    // FIX (Issue 7): was `false` (comment said "skip enrichment" but value was wrong)
    skip_enrichment   = true

    // Lower QC threshold appropriate for tiny subsampled files
    min_trimmed_reads = 1000
}

// Reduce resource requests so the test can run on a single laptop core
process {
    cpus   = 2
    memory = 6.GB
    time   = 1.h
}

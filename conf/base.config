/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/base.config  —  Default resource limits and retry strategy
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ── Global defaults ───────────────────────────────────────────────────────
    cpus   = 2
    memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
    // FIX: global time is now a closure so it also scales on retry,
    // consistent with the per-process withName overrides below.
    time   = { check_max( 4.h   * task.attempt, 'time'   ) }

    // ── Error / retry strategy ────────────────────────────────────────────────
    // Exit codes: 143=SIGTERM, 137=OOM-kill, 104/134/139=segfault variants
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 3

    // ── Per-process resource overrides ────────────────────────────────────────

    withName: 'FASTQC_RAW|FASTQC_TRIM' {
        cpus   = 4
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 2.h   * task.attempt, 'time'   ) }
    }

    withName: 'FASTP|fastp' {
        cpus   = 8
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }

    withName: 'multiqc' {
        cpus   = 2
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 2.h   * task.attempt, 'time'   ) }
    }

    withName: 'kallisto|kallisto_index' {
        cpus   = { params.kallisto_threads }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }

    withName: 'download_reference_files' {
        cpus   = 1
        memory = { check_max( 2.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 1.h   * task.attempt, 'time'   ) }
    }

    withName: 'prepare_tx2gene' {
        cpus   = 2
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 2.h   * task.attempt, 'time'   ) }
    }

    withName: 'prepare_transcript_fasta' {
        cpus   = 2
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }

    withName: 'store_kallisto_index' {
        cpus   = 1
        memory = { check_max( 2.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 1.h   * task.attempt, 'time'   ) }
    }

    withName: 'de_analysis' {
        cpus   = 4
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }

    withName: 'gsea' {
        cpus   = 2
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }

    withName: 'ora' {
        cpus   = 2
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }
}

// ── Resource cap helper ───────────────────────────────────────────────────────
params {
    max_cpus   = 16
    max_memory = 128.GB
    max_time   = 48.h
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) { return obj }
    }
}

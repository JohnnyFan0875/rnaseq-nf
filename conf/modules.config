/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/modules.config  —  Centralised publishDir directives for every process
    All output paths are rooted at params.outdir so modules themselves stay portable.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ── FastQC (pre-trim) ─────────────────────────────────────────────────────
    withName: 'fastqc_pre' {
        publishDir = [
            path:    { "${params.outdir}/fastqc_pre" },
            mode:    'copy',
            pattern: "*_fastqc.*"
        ]
    }

    // ── FastQC (post-trim) ────────────────────────────────────────────────────
    withName: 'fastqc_post' {
        publishDir = [
            path:    { "${params.outdir}/fastqc_post" },
            mode:    'copy',
            pattern: "*_fastqc.*"
        ]
    }

    // ── fastp ─────────────────────────────────────────────────────────────────
    withName: 'fastp' {
        publishDir = [
            [
                path:    { "${params.outdir}/fastp_trim" },
                mode:    'copy',
                pattern: "*.{html,json}"
            ],
            // FIX: enabled was hardcoded to `false` — changed to a closure so
            // params.save_trimmed = true at runtime actually takes effect.
            [
                path:    { "${params.outdir}/fastp_trim" },
                mode:    'copy',
                pattern: "*.trimmed.fastq.gz",
                enabled: { params.save_trimmed == true }
            ]
        ]
    }

    // ── MultiQC ───────────────────────────────────────────────────────────────
    withName: 'multiqc' {
        publishDir = [
            [
                path:    { "${params.outdir}/multiqc" },
                mode:    'copy',
                pattern: "multiqc_report.html"
            ],
            [
                path:    { "${params.outdir}/multiqc" },
                mode:    'copy',
                pattern: "multiqc_data"
            ]
        ]
    }

    // ── Kallisto ──────────────────────────────────────────────────────────────
    // FIX (Bug A): Removed pattern:"${sample_id}" — process variables are not
    // in scope inside config files. Using saveAs closure on pattern:"*" instead.
    // FIX (Bug B): Replaced "**/*.log" glob — Nextflow publishDir uses Java
    // PathMatcher which does not support ** across directory boundaries.
    // The log lives at <sample_id>/kallisto_<sample_id>.log, so "*/*.log" matches.
    withName: 'kallisto' {
        publishDir = [
            // Quant directories — copy everything except logs
            [
                path:    { "${params.outdir}/kallisto_quant" },
                mode:    'copy',
                pattern: "*",
                saveAs:  { filename -> filename.endsWith('.log') ? null : filename }
            ],
            // Per-sample logs → dedicated subdirectory for MultiQC ingestion
            [
                path:    { "${params.outdir}/kallisto_quant/logs" },
                mode:    'copy',
                pattern: "*/*.log"
            ]
        ]
    }

    // ── Differential expression ───────────────────────────────────────────────
    withName: 'de_analysis' {
        publishDir = [
            path:    { "${params.outdir}/de_analysis" },
            mode:    'copy',
            pattern: "DEG_*"
        ]
    }

    // ── GSEA ──────────────────────────────────────────────────────────────────
    withName: 'gsea' {
        publishDir = [
            path:    { "${params.outdir}/enrichment_analysis" },
            mode:    'copy',
            pattern: "gsea_results"
        ]
    }

    // ── ORA ───────────────────────────────────────────────────────────────────
    withName: 'ora' {
        publishDir = [
            path:    { "${params.outdir}/enrichment_analysis" },
            mode:    'copy',
            pattern: "ora_results"
        ]
    }
}

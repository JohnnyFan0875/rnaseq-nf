/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    conf/modules.config  —  Centralised publishDir directives for every process
    All output paths are rooted at params.outdir so modules themselves stay portable.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    // ── FastQC (raw reads) ───────────────────────────────────────────────────
    withName: 'FASTQC_RAW' {
        publishDir = [
            path:    { "${params.outdir}/fastqc_raw" },
            mode:    'copy',
            pattern: "*_fastqc.*"
        ]
    }

    // ── FastQC (trimmed reads) ───────────────────────────────────────────────
    withName: 'FASTQC_TRIM' {
        publishDir = [
            path:    { "${params.outdir}/fastqc_trim" },
            mode:    'copy',
            pattern: "*_fastqc.*"
        ]
    }

    // ── fastp ─────────────────────────────────────────────────────────────────
    withName: 'FASTP|fastp' {
        publishDir = [
            [
                path:    { "${params.outdir}/fastp_trim" },
                mode:    'copy',
                pattern: "*.fastp.{html,json}"
            ],
            [
                path:    { "${params.outdir}/fastp_trim" },
                mode:    'copy',
                pattern: "*.fastp.fastq.gz",
                enabled: { params.save_trimmed == true }
            ]
        ]
    }

    // ── MultiQC ───────────────────────────────────────────────────────────────
    withName: 'multiqc' {
        publishDir = [
            [
                path:    { "${params.outdir}/multiqc" },
                mode:    'copy',
                pattern: "multiqc_report.html"
            ],
            [
                path:    { "${params.outdir}/multiqc" },
                mode:    'copy',
                pattern: "multiqc_data"
            ]
        ]
    }

    // ── Kallisto ──────────────────────────────────────────────────────────────
    withName: 'kallisto' {
        publishDir = [
            [
                path:    { "${params.outdir}/kallisto_quant" },
                mode:    'copy',
                pattern: "*",
                saveAs:  { filename ->
                    filename.endsWith('.log') || filename.endsWith('.run_info.json') ? null : filename
                }
            ],
            [
                path:    { "${params.outdir}/kallisto_quant/logs" },
                mode:    'copy',
                pattern: "*.log"
            ]
        ]
    }

    // ── Reference assets ──────────────────────────────────────────────────────
    withName: 'prepare_reference_assets' {
        publishDir = [
            [
                path:    { params.ref_dir },
                mode:    'copy',
                pattern: "Homo_sapiens.GRCh38.113.gtf"
            ],
            [
                path:    { params.ref_dir },
                mode:    'copy',
                pattern: "Homo_sapiens.GRCh38.dna.primary_assembly.fa"
            ],
            [
                path:    { params.ref_dir },
                mode:    'copy',
                pattern: "transcripts.GRCh38.113.fa"
            ],
            [
                path:    { params.ref_dir },
                mode:    'copy',
                pattern: "transcripts.GRCh38.113.kallisto.idx"
            ]
        ]
    }

    // ── Differential expression ───────────────────────────────────────────────
    withName: 'deg_analysis' {
        publishDir = [
            path:    { "${params.outdir}/deg_analysis" },
            mode:    'copy',
            pattern: "DEG_*"
        ]
    }

    // ── GSEA ──────────────────────────────────────────────────────────────────
    withName: 'gsea' {
        publishDir = [
            path:    { "${params.outdir}/enrichment_analysis" },
            mode:    'copy',
            pattern: "gsea_results"
        ]
    }

    // ── ORA ───────────────────────────────────────────────────────────────────
    withName: 'ora' {
        publishDir = [
            path:    { "${params.outdir}/enrichment_analysis" },
            mode:    'copy',
            pattern: "ora_results"
        ]
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RNA-seq Analysis Pipeline — nextflow.config
    Follows nf-core configuration best practices
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'rnaseq-local'
    author          = 'johnnyfan0875'
    description     = 'RNA-seq quantification and differential expression pipeline'
    version         = '0.2.0'
    nextflowVersion = '>=24.10.0'
    defaultBranch   = 'main'
}

// ── Global default parameters ─────────────────────────────────────────────────
params {

    // === Required (must be provided at runtime) ===
    project_name        = null
    outdir              = null

    // === Input ===
    metadata_file       = null          // resolved in workflow if null

    // === Reference ===
    ref_dir                 = "${projectDir}/reference"
    reference_auto_download = true
    gtf_url                 = 'https://ftp.ensembl.org/pub/release-113/gtf/homo_sapiens/Homo_sapiens.GRCh38.113.gtf.gz'
    genome_fasta_url        = 'https://ftp.ensembl.org/pub/release-113/fasta/homo_sapiens/dna/Homo_sapiens.GRCh38.dna.primary_assembly.fa.gz'

    // === Quantification ===
    kallisto_threads    = 4

    // === Differential expression ===
    de_method           = 'edgeR'       // edgeR | DESeq2

    // === Enrichment analysis ===
    organism            = 'human'       // used by gsea / ora scripts

    // === Pipeline control flags ===
    skip_trimming       = false
    skip_enrichment     = false
    save_trimmed        = false

    // === QC thresholds ===
    min_trimmed_reads   = 1000000
}

process {
    withName: 'download_reference_files' {
        container = 'busybox:1.36.1'
    }
    withName: 'prepare_tx2gene' {
        // TODO: consider a dedicated lightweight image for tx2gene generation.
        container = 'johnnyfan0875/de_analysis:0.1.0'
    }
    withName: 'prepare_transcript_fasta' {
        container = 'zavolab/gffread:0.11.7-slim'
    }
    withName: 'store_kallisto_index' {
        container = 'busybox:1.36.1'
    }
    withName: 'de_analysis' {
        container = 'johnnyfan0875/de_analysis:0.1.0'
    }
    withName: 'gsea' {
        container = 'johnnyfan0875/enrichment_analysis:0.1.0'
    }
    withName: 'ora' {
        container = 'johnnyfan0875/enrichment_analysis:0.1.0'
    }
}

// ── Sub-config includes ───────────────────────────────────────────────────────
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ── Profiles ─────────────────────────────────────────────────────────────────
profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g) -e HOME=/tmp'
    }

    test {
        includeConfig 'conf/test.config'
    }

    local {
        process.executor = 'local'
        docker.enabled   = false
    }
}

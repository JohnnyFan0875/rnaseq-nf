/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    RNA-seq Analysis Pipeline — nextflow.config
    Follows nf-core configuration best practices
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

manifest {
    name            = 'rnaseq-local'
    author          = 'johnnyfan0875'
    description     = 'RNA-seq quantification and differential expression pipeline'
    version         = '0.2.0'
    nextflowVersion = '>=24.10.0'
    defaultBranch   = 'main'
}

// ── Global default parameters ─────────────────────────────────────────────────
params {

    // === Required (must be provided at runtime) ===
    project_name        = null
    outdir              = null

    // === Input ===
    metadata_file       = null          // resolved in workflow if null

    // === Reference ===
    // Note: params.ref_dir cannot be referenced inside the params block itself
    // (Nextflow does not evaluate intra-params GStrings at config parse time).
    // Both paths are defined explicitly using projectDir.
    ref_dir        = "${projectDir}/reference"
    kallisto_index = "${projectDir}/reference/transcripts.GRCh38.113.fa.idx"

    // === Quantification ===
    kallisto_threads    = 4

    // === Differential expression ===
    de_method           = 'edgeR'       // edgeR | DESeq2

    // === Enrichment analysis ===
    organism            = 'human'       // used by gsea / ora scripts

    // === Pipeline control flags ===
    skip_trimming       = false
    skip_enrichment     = false

    // === QC thresholds ===
    min_trimmed_reads   = 1000000
}

// ── Container definitions ─────────────────────────────────────────────────────
// RESTORED: These were dropped during Phase 2 refactor. Containers must be
// declared here (or in modules) — docker.enabled=true alone is not sufficient.
process {
    withName: 'fastqc|fastqc_pre|fastqc_post' {
        container = 'biocontainers/fastqc:v0.11.9_cv8'
    }
    withName: 'fastp' {
        container = 'biocontainers/fastp:v0.20.1_cv1'
    }
    withName: 'multiqc' {
        container = 'multiqc/multiqc:v1.28'
    }
    withName: 'kallisto' {
        container = 'quay.io/biocontainers/kallisto:0.50.1--h6de1650_2'
    }
    withName: 'de_analysis' {
        container = 'johnnyfan0875/de_analysis:0.1.0'
    }
    withName: 'gsea' {
        container = 'johnnyfan0875/enrichment_analysis:0.1.0'
    }
    withName: 'ora' {
        container = 'johnnyfan0875/enrichment_analysis:0.1.0'
    }
}

// ── Sub-config includes ───────────────────────────────────────────────────────
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

// ── Profiles ─────────────────────────────────────────────────────────────────
profiles {

    docker {
        docker.enabled      = true
        docker.runOptions   = '-u $(id -u):$(id -g) -e HOME=/tmp'
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    slurm {
        includeConfig 'conf/slurm.config'
    }

    test {
        includeConfig 'conf/test.config'
    }

    local {
        process.executor = 'local'
        docker.enabled   = false
    }
}
